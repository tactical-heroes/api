{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSqlConnectionString": "Host=localhost;Port=5432;Database=tactical-heroes;Username=postgres"
  },
  "HttpModules": {
    "PANiXiDA.TacticalHeroes.Identity.Presentation": {
      "Name": "identity",
      "Title": "Identity API"
    },
    "PANiXiDA.TacticalHeroes.Compendium.Presentation": {
      "Name": "compendium",
      "Title": "Compendium API"
    },
    "PANiXiDA.TacticalHeroes.FileManager.Presentation": {
      "Name": "file-manager",
      "Title": "File Manager API"
    }
  },
  "ScalarConfiguration": {
    "Title": "Tactical Heroes API Reference",
    "BearerAuthenticationSchemes": [
      "OpenIddict.Validation.AspNetCore",
      "OpenIddict.Server.AspNetCore"
    ]
  },
  "OpenIddictValidationOptions": {
    "Issuer": "https://localhost:7091/",
    "Audiences": [
      "tactical-heroes-service"
    ],
    "ClientId": "tactical-heroes-service",
    "ClientSecret": ""
  },
  "Identity": {
    "Provider": {
      "Issuer": "https://localhost:7091/",
      "Audience": "tactical-heroes-service",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00",
      "RefreshTokenReuseLeeway": "00:00:30",
      "AuthorizationCodeLifetime": "00:05:00",
      "IdentityTokenLifetime": "00:05:00",
      "EmailConfirmationTokenLifetime": "1.00:00:00",
      "AccountRecoveryTokenLifetime": "01:00:00",
      "User": {
        "RequireUniqueEmail": true
      },
      "Password": {
        "RequiredLength": 8,
        "RequiredUniqueChars": 1,
        "RequireDigit": true,
        "RequireLowercase": true,
        "RequireNonAlphanumeric": true,
        "RequireUppercase": true
      },
      "Lockout": {
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": "00:05:00"
      },
      "TokenProviders": {
        "EmailConfirmation": "email_confirmation",
        "PasswordReset": "password_reset"
      },
      "Clients": [
        {
          "ClientId": "tactical-heroes-web",
          "ClientType": "public",
          "DisplayName": "Tactical Heroes Web",
          "GrantTypes": [
            "authorization_code",
            "refresh_token"
          ],
          "RedirectUris": [
            "https://localhost:5173/oauth/callback",
            "https://dev.tactical-heroes.panixida.ru/oauth/callback",
            "https://tactical-heroes.panixida.ru/oauth/callback"
          ],
          "PostLogoutRedirectUris": [
            "https://localhost:5173/oauth/logout-callback",
            "https://dev.tactical-heroes.panixida.ru/oauth/logout-callback",
            "https://tactical-heroes.panixida.ru/oauth/logout-callback"
          ],
          "Scopes": [
            "openid",
            "offline_access",
            "profile",
            "email",
            "roles"
          ]
        },
        {
          "ClientId": "tactical-heroes-service",
          "ClientSecret": "development-only-secret",
          "ClientType": "confidential",
          "DisplayName": "Tactical Heroes Service",
          "GrantTypes": [
            "client_credentials",
            "urn:ietf:params:oauth:grant-type:token-exchange"
          ],
          "Scopes": [
            "profile",
            "email",
            "roles"
          ]
        }
      ]
    },
    "Cleanup": {
      "PruneUnconfirmedUsersEnabled": true,
      "UnconfirmedUserRetention": "7.00:00:00",
      "UnconfirmedUsersCronSchedule": "0 0 * * * ?"
    },
    "Messaging": {
      "EmailConfirmationUrlTemplate": "https://localhost:5173/confirm-email?userId={userId}&emailConfirmationToken={token}",
      "PasswordResetUrlTemplate": "https://localhost:5173/reset-password?userId={userId}&passwordResetToken={token}"
    }
  },
  "OAuthSpa": {
    "LoginUrl": "https://localhost:5173/login"
  },
  "FileManager": {
    "AWS": {
      "ServiceURL": "https://s3.example.invalid",
      "AuthenticationRegion": "us-east-1",
      "ForcePathStyle": true
    },
    "S3Storage": {
      "BucketName": "tactical-heroes-files",
      "KeyPrefix": "production",
      "AccessKey": "mock-access-key",
      "SecretKey": "mock-secret-key",
      "DownloadPartSizeBytes": 8388608,
      "MaxInMemoryDownloadParts": 4,
      "PresignedUrlLifetime": "00:15:00"
    }
  },
  "Notifications": {
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "SocketOptions": "None",
        "SenderEmail": "no-reply@tactical-heroes.local",
        "SenderName": "Tactical Heroes"
      }
    }
  },
  "OTEL_SERVICE_NAME": "tactical-heroes-api",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector.observability.svc.cluster.local:4317"
}
